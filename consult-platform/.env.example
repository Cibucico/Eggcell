# Copy to .env.local for development, or set these in your hosting provider.

# --- Brand -----------------------------------------------------------------
# Which brand preset to build (see src/config/presets). Default: meridian
NEXT_PUBLIC_BRAND=meridian
# Public address of the site, no trailing slash. Used for links, SEO and payments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Supabase) ---------------------------------------------------
# Leave empty to run in preview mode with sample content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key. Server only: never expose it or prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Email (Resend) --------------------------------------------------------
# Optional. Without these, notification emails are skipped.
RESEND_API_KEY=
EMAIL_FROM="Meridian Advisory <no-reply@example.com>"
# Where new enquiries and bookings are sent. Defaults to the brand's contact email.
NOTIFY_EMAIL=
