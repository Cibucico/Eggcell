/**
 * Writes supabase/seed.sql from src/content/seed.ts.
 * Run with: npm run seed:sql
 */
import { writeFileSync } from "node:fs";
import {
  seedCaseStudies,
  seedCourses,
  seedLiveSessions,
  seedServices,
  seedTeam,
  seedTestimonials,
} from "../src/content/seed.ts";

const q = (v: unknown): string => {
  if (v === null || v === undefined) return "null";
  if (typeof v === "number") return String(v);
  if (typeof v === "boolean") return v ? "true" : "false";
  if (Array.isArray(v)) {
    if (v.length === 0) return "'{}'";
    return `array[${v.map((x) => q(x)).join(", ")}]`;
  }
  return `'${String(v).replace(/'/g, "''")}'`;
};

const insert = (table: string, rows: Record<string, unknown>[], conflict = "id") => {
  if (rows.length === 0) return "";
  const cols = Object.keys(rows[0]);
  const values = rows
    .map((r) => `  (${cols.map((c) => (c === "metrics" || c === "blocks" ? `${q(JSON.stringify(r[c]))}::jsonb` : q(r[c]))).join(", ")})`)
    .join(",\n");
  return `insert into public.${table} (${cols.join(", ")}) values\n${values}\non conflict (${conflict}) do nothing;\n`;
};

const courses = seedCourses.map(({ modules: _m, ...c }) => ({ ...c, published: true }));
const modules = seedCourses.flatMap((c) =>
  c.modules.map((m) => ({ id: m.id, course_id: c.id, title: m.title, sort_order: m.sort_order })),
);
const lessons = seedCourses.flatMap((c) =>
  c.modules.flatMap((m) =>
    m.lessons.map((l) => ({
      id: l.id,
      course_id: c.id,
      module_id: m.id,
      title: l.title,
      duration_minutes: l.duration_minutes,
      is_preview: l.is_preview,
      sort_order: l.sort_order,
    })),
  ),
);
const contents = seedCourses.flatMap((c) =>
  c.modules.flatMap((m) =>
    m.lessons.map((l) => ({ lesson_id: l.id, blocks: l.blocks })),
  ),
);

const sql = [
  "-- Generated by scripts/generate-seed.mts from src/content/seed.ts. Do not edit by hand.",
  "-- SAMPLE content for a fictional consultancy; replace before going live.\n",
  insert("services", seedServices),
  insert("team_members", seedTeam),
  insert("case_studies", seedCaseStudies),
  insert("testimonials", seedTestimonials),
  insert("courses", courses),
  insert("course_modules", modules),
  insert("lessons", lessons),
  insert("lesson_contents", contents, "lesson_id"),
  "-- Live sessions are seeded without a joining link; add the Zoom link in the admin area.",
  insert(
    "live_sessions",
    seedLiveSessions.map(({ join_url: _join, ...session }) => ({ ...session, published: true })),
  ),
  insert(
    "live_session_links",
    seedLiveSessions.map((session) => ({ session_id: session.id, join_url: session.join_url })),
    "session_id",
  ),
].join("\n");

writeFileSync(new URL("../supabase/seed.sql", import.meta.url), sql);
console.log(`Wrote supabase/seed.sql (${sql.length} bytes)`);
